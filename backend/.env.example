# Ambiente
APP_ENV=development

# FIWARE
FIWARE_BASE_URL=http://localhost:1026
IOT_AGENT_URL=http://localhost:4041
STH_COMET_URL=http://localhost:8666
FIWARE_SERVICE=smart
FIWARE_SERVICE_PATH=/
FIWARE_API_KEY=TEF
ENTITY_TYPE=VinTrace

# Atributos históricos
STH_TEMPERATURE_ATTRIBUTE=temperature
STH_HUMIDITY_ATTRIBUTE=humidity
STH_LUMINOSITY_ATTRIBUTE=luminosity

# Resolução usada para cobrir o período inteiro no STH-Comet
STH_24H_PERIOD=minute
STH_7D_PERIOD=hour
STH_30D_PERIOD=hour

# Fallback bruto do STH quando não houver dados agregados
STH_PAGE_SIZE=100
STH_FALLBACK_MAX_POINTS=600

# Triggers
# local  -> backend/data/triggers.json (desenvolvimento/testes)
# fiware -> atributos da entidade no Orion (recomendado no Render)
TRIGGER_STORAGE=local
TRIGGERS_FILE_PATH=data/triggers.json

# Monitor remoto
MONITORING_INTERVAL=5.0
